# Copy to .env (never commit .env). Used only by scripts on a computer / the host's build step.
# Public values (safe in the website):
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
# SECRET: only if you run admin scripts from a computer. Never put this in the website or in Git.
# The editor and the website do NOT need it.
# SUPABASE_SERVICE_ROLE_KEY=
