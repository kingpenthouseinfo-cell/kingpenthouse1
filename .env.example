# Copy these into Netlify > Site configuration > Environment variables.
# NEVER prefix with VITE_/NEXT_PUBLIC_/PUBLIC_ and never commit real values.

# --- Email (Resend) ---
RESEND_API_KEY=
KP_NOTIFICATION_EMAIL=
KP_FROM_EMAIL=

# --- WhatsApp Business Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
KP_ADMIN_WHATSAPP_NUMBER=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# optional: order of template body parameters
# WHATSAPP_TEMPLATE_PARAMS=event,name,age,type,email,fetlife,found,source,message,time

# --- Cloudflare Turnstile (optional but recommended) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
